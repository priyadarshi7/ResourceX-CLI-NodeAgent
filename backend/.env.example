# HTTP server
PORT=4000
HOST=0.0.0.0

# Required in production (signs user + node JWTs)
JWT_SECRET=change-me-to-a-long-random-string

# MongoDB — job submitters go to database/collection: <db>.users
#
# Atlas (recommended): Connect → Drivers → copy mongodb+srv URI, then add /resourcex before ?
# Example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/resourcex?retryWrites=true&w=majority
# MONGODB_DB=resourcex
#
# If PASSWORD contains @ # : / etc., URL-encode it (e.g. @ → %40)
#
# Docker + local Mongo (npm run deploy:up --profile local-mongo):
# MONGODB_URI=mongodb://mongo:27017/resourcex

MONGODB_URI=mongodb://127.0.0.1:27017/resourcex
MONGODB_DB=resourcex

# Redis / BullMQ (required)
# Local dev:
REDIS_URL=redis://127.0.0.1:6379
# Docker Compose overrides this to redis://redis:6379 inside the container

# ML jobs default container (must exist on Docker Hub)
# RESOURCEX_ML_IMAGE=python:3.11-slim

# Studio: URL nodes use to download uploaded datasets (LAN IP or public URL)
# PUBLIC_URL=http://192.168.1.10:4000
# STUDIO_MAX_UPLOAD_MB=512
# STUDIO_UPLOAD_DIR=./data/studio-uploads

# Browser clients (dashboard)
CORS_ORIGIN=*
